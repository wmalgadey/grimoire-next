{
  "name": "@grimoire/frontend",
  "version": "0.1.0",
  "private": true,
  "description": "The three operator surfaces: submit, task list, task view. Built static and served by the hub on one origin.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "api:types": "openapi-typescript ../contracts/hub-api.openapi.yaml -o src/lib/api/schema.d.ts",
    "prebuild": "npm run api:types",
    "build": "vite build",
    "preview": "vite preview",
    "dev": "vite dev",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.63.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@types/node": "^22.20.3",
    "dependency-cruiser": "^18.3.1",
    "eslint": "^9.0.0",
    "eslint-plugin-svelte": "^3.23.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.7",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.0.0"
  }
}
