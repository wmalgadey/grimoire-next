# Style and analysis rules for the whole tree. EnforceCodeStyleInBuild in Directory.Build.props
# makes the IDExxxx rules below build diagnostics, and TreatWarningsAsErrors makes them errors.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{md,markdown}]
trim_trailing_whitespace = false

[*.{json,yml,yaml}]
indent_size = 2

[*.{csproj,props,targets,slnx}]
indent_size = 2

[*.cs]
indent_size = 4
max_line_length = 120

# The complexity ceiling (Constitution II.3: the analysis the SDK already ships, nothing of our
# own). CA1502 is off by default in .NET 10 and its default threshold is 25; CodeMetricsConfig.txt
# sets ours to 15. It is an error rather than a warning for the same reason everything else here
# is: a warning that is only a warning is a rule nobody keeps.
dotnet_diagnostic.CA1502.severity = error

# Language conventions
csharp_using_directive_placement = outside_namespace:warning
csharp_style_namespace_declarations = file_scoped:warning
csharp_prefer_braces = true:warning
csharp_style_var_for_built_in_types = false:silent
csharp_style_var_when_type_is_apparent = true:silent
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
dotnet_style_readonly_field = true:warning
dotnet_style_prefer_is_null_check_over_reference_equality_method = true:warning
dotnet_style_coalesce_expression = true:warning
dotnet_style_null_propagation = true:warning

# IDE0005 (unused usings) is left at its default: raising it at build time demands
# GenerateDocumentationFile, and XML documentation files nobody reads are not worth the rule.
csharp_style_unused_value_expression_statement_preference = discard_variable:silent

# Naming
dotnet_naming_rule.private_fields_camel_case.severity = warning
dotnet_naming_rule.private_fields_camel_case.symbols = private_fields
dotnet_naming_rule.private_fields_camel_case.style = camel_case
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.camel_case.capitalization = camel_case

# Test projects: xunit's own analyzers apply; nothing is relaxed here.
