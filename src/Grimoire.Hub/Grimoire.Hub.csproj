<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The composition root: the only project that knows every context (plan.md, Structure
       Decision). -->
  <ItemGroup>
    <ProjectReference Include="../Grimoire.Agent/Grimoire.Agent.csproj" />
    <ProjectReference Include="../Grimoire.Runs/Grimoire.Runs.csproj" />
    <ProjectReference Include="../Grimoire.Wiki/Grimoire.Wiki.csproj" />
  </ItemGroup>

  <!-- The five wiki tools are served over MCP from the hub itself, at a per-run endpoint. The
       library is referenced here and nowhere else (research.md R-02). -->
  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
  </ItemGroup>

  <!-- The page travels with the built hub, so the server finds it under its own base directory
       whether it was started from the command line or by the E2E suite. -->
  <ItemGroup>
    <Content Update="wwwroot/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- So does the instruction, which is Grimoire's own and versioned in this repository (V.1).
       It is what the instruction argument defaults to, so it sits under the same base directory. -->
  <ItemGroup>
    <Content Include="../../instructions/ingest.md" Link="instructions/ingest.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
