<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Grimoire.Tests.Egress</RootNamespace>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/egress/Grimoire.Egress.csproj" />
    <!-- The shared fixtures in tests/support/ boot the hub; every suite compiles them. -->
    <ProjectReference Include="../../src/hub/Grimoire.Hub.csproj" />
  </ItemGroup>

  <!-- Configuration is process environment (constitution VII.1) and a run holds the wiki
       working tree, so suites that boot a hub cannot run beside each other. -->
  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
