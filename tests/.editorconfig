# Layered on the repository's root .editorconfig; this file adds only what the test suites need.

[*.cs]

# CA1707 "Identifiers should not contain underscores" fires as an error here — the root
# Directory.Build.props raises analysis to Recommended and turns warnings into errors, and test
# methods are publicly visible members. The naming convention in tests/README.md spells a test as
# <Action>_<Result>[_<Scenario>], where the underscores are what separate the three parts a reader
# scans in CI output. The rule is about identifiers an API exposes; a test method is called by the
# runner and by nobody else, so it is switched off here and stays on everywhere else in the tree.
dotnet_diagnostic.CA1707.severity = none
