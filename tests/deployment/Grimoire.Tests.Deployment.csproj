<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Grimoire.Tests.Deployment</RootNamespace>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <!-- No tests yet: this suite's first ones arrive with the phase that builds its slice
         (tasks.md Phases 5 and 6). Until then the platform's "zero tests ran" exit code 8
         would fail `dotnet test` for the whole solution. Delete this line with the first test. -->
    <TestingPlatformCommandLineArguments>--ignore-exit-code 8</TestingPlatformCommandLineArguments>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/hub/Grimoire.Hub.csproj" />
  </ItemGroup>

  <!-- Configuration is process environment (constitution VII.1) and a run holds the wiki
       working tree, so suites that boot a hub cannot run beside each other. -->
  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
