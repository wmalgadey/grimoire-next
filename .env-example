# What the hub is started with. Read by scripts/run-hub.sh; ignored by git.
# A relative path is taken from the repository root.

GRIMOIRE_WIKI=local/wiki
GRIMOIRE_PURPOSE=local/purpose.md

# A pinned model id, never an alias and never the CLI's default (DEC-010): a run is
# reproducible and its cost attributable only if the model is fixed.
GRIMOIRE_MODEL=claude-sonnet-5

# GRIMOIRE_URLS=http://127.0.0.1:5057
# GRIMOIRE_INSTRUCTION=instructions/ingest.md
