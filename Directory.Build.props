<Project>

  <!-- Shared by every project in the tree. The test suites add their own settings in
       tests/Directory.Build.props, which imports this file. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- The analysis the SDK already ships, and nothing of our own (Constitution II.3). The .NET
       analyzers are on by default; AnalysisMode raises them above the default set, and
       EnforceCodeStyleInBuild makes the .editorconfig style rules build errors rather than IDE
       suggestions. A warning that is only a warning is a rule nobody keeps, so they are errors. -->
  <PropertyGroup>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- The complexity ceiling. CA1502 reads its threshold from CodeMetricsConfig.txt, which the
       compiler has to be handed as an additional file; $(MSBuildThisFileDirectory) is required
       here because this is Directory.Build.props rather than a project file. The severity is set
       in .editorconfig, and tests/.editorconfig turns it off for the suites. -->
  <ItemGroup>
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)CodeMetricsConfig.txt" />
  </ItemGroup>

</Project>
